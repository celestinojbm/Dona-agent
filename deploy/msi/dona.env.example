# deploy/msi/dona.env.example — Env file de Dona staging en la MSI.
#
# Copia a una ruta FUERA del repo y restringe permisos:
#   install -m 600 deploy/msi/dona.env.example ~/secretos/dona/dona.env
# Rellena los valores solo en esa copia. Nunca la subas al repo.
#
# Perfil de pausa (J4): todos los efectos externos apagados. No hace falta
# ninguna credencial de cobro, envío ni modelos para arrancar.

# ── Entorno ───────────────────────────────────────────────
# Estricto (fail-closed): exige los secretos base de abajo.
ENVIRONMENT=staging

# ── Base obligatoria en entorno estricto ─────────────────
# Supabase (proyecto Dona): conexión directa o session pooler.
DATABASE_URL=
ENCRYPTION_KEY=
INTERNAL_BRIDGE_SECRET=
ADMIN_TOKEN=

# ── Efectos externos: APAGADOS (no cambiar sin decisión) ─
DONA_SCHEDULER_ENABLED=false
DONA_WORKER_ENABLED=false
DONA_WHATSAPP_ENABLED=false
DONA_STRIPE_ENABLED=false
DONA_LLM_ENABLED=false
DONA_INBOUND_ENABLED=false

# ── Jobs ──────────────────────────────────────────────────
# inproc sin Redis; con `arrancar.sh --arq` el compose fuerza arq+Redis
# en el worker.
JOBS_BACKEND=inproc

# ── Lo que NO va aquí en pausa ───────────────────────────
# STRIPE_*, WHAPI_*, META_*, ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_*,
# R2_*, GOOGLE_*: solo cuando su efecto se encienda con OK de Celestino.
